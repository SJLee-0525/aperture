rules_version = '2';

// Aperture. — Storage Security Rules
// read 는 공개(공개 페이지 이미지). 쓰기/삭제는 관리자만.
// 업로드는 image/* + 10MB 미만만 허용(무료 한도·악성 업로드 방지). 삭제는 request.resource 가 null.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "KBBvgyMIssPngwx9n0OXaL2THwy1"
                   && (
                        request.resource == null   // 삭제(deleteObject)
                        || (
                             request.resource.size < 10 * 1024 * 1024
                             && request.resource.contentType.matches('image/.*')
                           )
                      );
    }
  }
}
