rules_version = '2';

// Aperture. — Storage Security Rules
// 개별 파일 get 은 공개(공개 페이지 이미지), 경로 목록 조회·쓰기·삭제는 관리자만.
// 업로드는 image/* + 10MB 미만만 허용(무료 한도·악성 업로드 방지). 삭제는 request.resource 가 null.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "KBBvgyMIssPngwx9n0OXaL2THwy1";
    }

    match /{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin()
                   && (
                        request.resource == null   // 삭제(deleteObject)
                        || (
                             request.resource.size < 10 * 1024 * 1024
                             && request.resource.contentType.matches('image/.*')
                           )
                      );
    }
  }
}
