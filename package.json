{
  "name": "aperture",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src",
    "check": "next typegen && tsc --noEmit",
    "jscpd": "jscpd src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/run.cjs --production --build",
    "test:e2e:ci": "node e2e/run.cjs",
    "test:e2e:admin": "node e2e/run.cjs e2e/admin",
    "test:e2e:headed": "node e2e/run.cjs --headed",
    "test:visual": "node e2e/run.cjs --production --build e2e/visual",
    "test:visual:update": "node e2e/run.cjs --production --build e2e/visual --update-snapshots",
    "test:a11y": "node e2e/run.cjs e2e/accessibility.e2e.ts",
    "test:chat-eval": "node scripts/run-chat-eval.mjs",
    "test:chat-eval:live": "node scripts/chat-eval.mjs",
    "test:lighthouse": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:rules": "node scripts/run-supabase-rls-tests.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
