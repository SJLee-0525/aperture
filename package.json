{
  "name": "aperture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "check": "tsc --noEmit",
    "jscpd": "jscpd src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/run.cjs",
    "test:e2e:headed": "node e2e/run.cjs --headed",
    "test:rules": "firebase emulators:exec --project demo-aperture --only firestore,storage \"node --test test/security-rules.test.mjs\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "browser-image-compression": "^2.0.2",
    "exifr": "^7.1.3",
    "firebase": "^12.15.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-boundaries": "^7.1.0",
    "firebase-tools": "^15.24.0",
    "jscpd": "^5.0.14",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "prettier": "^3.8.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
