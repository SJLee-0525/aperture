# ─────────────────────────────────────────────────────────────
# Aperture. 환경변수 예시
#   이 파일을 복사해서 `.env.local` 로 만들고 실제 값을 채우세요.
#     cp .env.example .env.local
#   `.env.local` 은 git 에 커밋되지 않습니다(.gitignore). 절대 커밋 금지.
#
#   ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출됩니다.
#      Firebase 웹 키(AIza…)는 공개돼도 안전합니다 — 보안은 Firestore/Storage
#      Security Rules 가 담당합니다(아키텍처 원칙 #1). 진짜 시크릿은 여기 없습니다.
# ─────────────────────────────────────────────────────────────

# ── Firebase 웹 앱 설정 ──────────────────────────────────────
# 위치: Firebase 콘솔 → ⚙️ 프로젝트 설정(Project settings)
#        → 일반(General) 탭 → "내 앱(Your apps)" 섹션의 웹 앱 </> → firebaseConfig
#   (웹 앱이 아직 없으면 </> 아이콘으로 웹 앱을 먼저 등록. Hosting 체크는 불필요.)
#
# firebaseConfig 객체의 각 키 → 아래 변수로 옮기면 됩니다:
#   apiKey            → NEXT_PUBLIC_FIREBASE_API_KEY
#   authDomain        → NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   projectId         → NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   storageBucket     → NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#   messagingSenderId → NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   appId             → NEXT_PUBLIC_FIREBASE_APP_ID

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...............................
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── 관리자 UID (UI 가드용) ───────────────────────────────────
# 위치: Firebase 콘솔 → 빌드(Build) → Authentication → Users 탭 → 본인 계정의 "사용자 UID"
#   (먼저 Authentication 에서 이메일/비밀번호 로그인 활성화 + 관리자 계정 1개를
#    "사용자 추가"로 수동 생성해야 UID 가 생깁니다. 회원가입 UI 는 만들지 않습니다.)
#
#   ⚠️ 이 값은 UI 편의상의 가드일 뿐, 보안 경계가 아닙니다.
#      실제 관리자 판별은 firestore.rules 의 isAdmin() 에 하드코딩한 UID 로 합니다(P2).
NEXT_PUBLIC_ADMIN_UID=your-admin-uid-from-authentication

# 참고: 지도(MapLibre GL + CARTO)는 무료 타일이라 키가 필요 없습니다.
