# ─────────────────────────────────────────────────────────────
# Aperture. 환경변수 예시
#   이 파일을 복사해서 `.env.local` 로 만들고 실제 값을 채우세요.
#     cp .env.example .env.local
#   `.env.local` 은 git 에 커밋되지 않습니다(.gitignore). 절대 커밋 금지.
#
#   ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출됩니다.
#      Firebase 웹 키(AIza…)는 공개돼도 안전합니다 — 보안은 Firestore/Storage
#      Security Rules 가 담당합니다(아키텍처 원칙 #1). 진짜 시크릿은 여기 없습니다.
# ─────────────────────────────────────────────────────────────

# ── 사이트 공개 URL (SEO 필수) ───────────────────────────────
# canonical, Open Graph, robots.txt, sitemap.xml의 절대 URL 기준입니다.
# 운영 환경에는 실제 대표 도메인을 프로토콜과 함께 입력하세요(끝의 /는 선택).
SITE_URL=https://example.com

# ── 검색엔진 소유 확인 (선택) ────────────────────────────────
# 각 웹마스터 도구에서 HTML meta 태그 방식을 선택한 뒤 content 값만 입력합니다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ── Firebase 웹 앱 설정 ──────────────────────────────────────
# 위치: Firebase 콘솔 → ⚙️ 프로젝트 설정(Project settings)
#        → 일반(General) 탭 → "내 앱(Your apps)" 섹션의 웹 앱 </> → firebaseConfig
#   (웹 앱이 아직 없으면 </> 아이콘으로 웹 앱을 먼저 등록. Hosting 체크는 불필요.)
#
# firebaseConfig 객체의 각 키 → 아래 변수로 옮기면 됩니다:
#   apiKey            → NEXT_PUBLIC_FIREBASE_API_KEY
#   authDomain        → NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   projectId         → NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   storageBucket     → NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#   messagingSenderId → NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   appId             → NEXT_PUBLIC_FIREBASE_APP_ID

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...............................
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── 관리자 UID (UI 가드용) ───────────────────────────────────
# 위치: Firebase 콘솔 → 빌드(Build) → Authentication → Users 탭 → 본인 계정의 "사용자 UID"
#   (먼저 Authentication 에서 이메일/비밀번호 로그인 활성화 + 관리자 계정 1개를
#    "사용자 추가"로 수동 생성해야 UID 가 생깁니다. 회원가입 UI 는 만들지 않습니다.)
#
#   ⚠️ UID 자체는 비밀이 아닙니다. Firestore/Storage는 Rules의 isAdmin()이,
#      캐시 재검증 server action은 Firebase가 검증한 ID token의 UID 비교가 권한을 판별합니다.
NEXT_PUBLIC_ADMIN_UID=your-admin-uid-from-authentication

# ── 콘텐츠 소스 스위치 (선택) ────────────────────────────────
# 공개 페이지가 mock 대신 실제 Firestore 를 읽을지 결정합니다. (lib/content/content-source.ts)
#   미설정(기본) : 개발(npm run dev)=mock, 프로덕션 빌드=실데이터
#   =0           : 항상 실데이터 — dev 에서도 Firestore 를 읽습니다(실콘텐츠 확인용)
#   =1           : 항상 mock  ⚠️ 프로덕션/Vercel 에는 설정 금지(실서비스가 mock 을 노출)
# 로컬에서 실데이터로 보려면 .env.local 에 이 줄을 넣으세요(앱이 실제로 읽는 파일은 .env.local 입니다).
NEXT_PUBLIC_USE_MOCK=0

# ── 연락 폼 발송 (Web3Forms) ─────────────────────────────────
# /contact 폼을 사이트 안에서 실제 발송하는 서비스. https://web3forms.com 에서
# 수신할 메일 주소를 입력하면 access key 를 무료로 발급해 줍니다(가입 불필요, 월 250건).
#   ⚠️ 이 키는 "수신 주소 매핑"용 공개 키라 브라우저 노출이 안전합니다(진짜 시크릿 아님).
#   미설정 시 폼은 mailto 폴백(방문자 메일 앱 열기)으로 동작합니다.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# ── Google Analytics 4 (선택) ────────────────────────────────
# 위치: GA 콘솔 → 관리(⚙️) → 데이터 스트림 → 웹 스트림 선택 → 우상단 "측정 ID"(G-XXXXXXXXXX)
#   비워 두면 gtag 스크립트를 아예 심지 않습니다(로컬 새로고침이 통계를 오염시키지 않도록
#   .env.local 에는 넣지 않는 것을 권장 — 실제 값은 Vercel 환경변수에만 두세요).
#   ⚠️ GA 콘솔 → 데이터 스트림 → 향상된 측정 → "브라우저 기록 이벤트 기반 페이지 변경"은 꺼야 합니다.
#      코드가 라우트 변경마다 page_view 를 직접 보내므로, 켜두면 조회수가 두 배로 잡힙니다.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Sentry 오류 모니터링 (선택) ──────────────────────────────
# 위치: Sentry → Settings → Projects → 프로젝트 선택 → Client Keys (DSN)
#   DSN이나 아래 저장 지역을 비우면 브라우저·Node·Edge에서 Sentry가 동작하지 않습니다.
#   DSN은 이벤트 수신 주소이므로 공개돼도 됩니다. AUTH_TOKEN은 공개하면 안 됩니다.
#   브라우저 수집은 동의 배너에서 오류 보고를 따로 허용한 뒤에만 시작됩니다(ADR-0004).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry 조직의 실제 데이터 저장 지역. DSN host가 ingest.us.sentry.io면 US,
# ingest.de.sentry.io면 DE. 미설정·불일치 시 개인정보 국외 이전 고지를 위해 Sentry가 비활성화됩니다.
NEXT_PUBLIC_SENTRY_DATA_REGION=US

# 소스맵 업로드 토큰 (빌드 전용 시크릿)
# 위치: Sentry → Settings → Auth Tokens (scopes: project:releases, org:read)
#   실제 값은 .env.sentry-build-plugin(로컬)과 Vercel 환경변수(Sensitive)에만 둡니다.
#   NEXT_PUBLIC_ 접두사를 붙이지 마세요. 값이 없으면 소스맵 업로드만 건너뛰며 빌드는 계속됩니다.
# SENTRY_AUTH_TOKEN=

# ── WebMCP 오리진 트라이얼 (선택) ────────────────────────────
# 위치: https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241
#   프로덕션 도메인으로 발급한 토큰을 넣으면 지원 Chrome 에서 WebMCP 도구가 켜집니다.
#   비워 두면 meta 태그를 심지 않습니다 — 이 값 하나가 킬 스위치입니다(별도 플래그 없음).
#   로컬 검증은 토큰 없이 chrome://flags/#enable-webmcp-testing 활성화로 대체합니다.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=

# 참고: 지도(MapLibre GL + CARTO)는 무료 타일이라 키가 필요 없습니다.

# ── 챗봇 제공자 (서버 전용) ───────────────────────────────────
# 로컬은 .env.local, 운영은 Vercel의 server-only 환경변수에 설정합니다.
#   ⚠️ API 키에 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 브라우저에 노출됩니다.
# CHAT_PROVIDER=mock 으로 설정하면 외부 API 없이 목 응답을 사용합니다.
# 메인이 응답을 시작하기 전에 실패하면 별도 키를 쓰는 폴백 제공자로 넘어갑니다.
#
# 메인·서브는 아래 6줄을 통째로 맞바꾸기만 하면 되고 코드 수정은 필요 없습니다.
# (openai <-> gemini). 잘림 회수·출력 상한·오류 분류는 두 제공자가 공유하므로
# 어느 쪽을 메인에 두든 방문자가 보는 동작은 같습니다.
CHAT_PROVIDER=openai
CHAT_PROVIDER_MODEL=gpt-5.6-luna
CHAT_PROVIDER_API_KEY=
CHAT_FALLBACK_PROVIDER=gemini
CHAT_FALLBACK_PROVIDER_MODEL=gemini-3.5-flash-lite
CHAT_FALLBACK_PROVIDER_API_KEY=

# 최근 대화의 포트폴리오 섹션을 분류합니다(OpenAI 전용).
#   ⚠️ 채팅 제공자 키를 공유하지 않으므로 이 키를 직접 채워야 분류기가 켜집니다.
#      비워 두면 오류 없이 정규식 분류기로 동작합니다 — 조용히 품질만 떨어지니 주의하세요.
#      대신 챗봇을 Gemini로 바꿔도 분류기는 그대로 유지됩니다.
# 호출 실패·none 응답 시에도 정규식 분류기로 폴백합니다.
CHAT_INTENT_MODEL=gpt-5-nano
CHAT_INTENT_PROVIDER_API_KEY=
CHAT_INTENT_TIMEOUT_MS=3000

# 임베딩 제공자 (서버 전용, 채팅 키와 분리)
# 차원은 MRL 잘라내기(기본 512) — 코퍼스 규모 대비 품질 손실 없이 저장·전송 1/3.
#   ⚠️ 모델이나 차원을 바꾸면 저장·검색 호환성 키(모델명@차원)가 어긋나므로
#      /admin/maintenance 에서 전체 임베딩 재생성이 필요합니다.
EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER_DIMENSIONS=512
EMBEDDING_PROVIDER_API_KEY=

# 공유 요청 제한 (배포 환경 필수)
# 아래 한 쌍 대신 Vercel Marketplace 가 주입하는 KV_REST_API_URL + KV_REST_API_TOKEN 도
# 자동 인식합니다 — 그쪽을 쓰면 아래 두 줄은 비워 두세요.
#   ⚠️ 배포 환경에 자격증명이 없으면 챗을 503 으로 닫습니다. 인스턴스 메모리 폴백은
#      서버리스에서 동시 요청만으로 우회돼 제한이 있다는 착각만 남기기 때문입니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 전역 일일 상한 (선택 — 기본 1,000, 리셋은 UTC 자정)
# 분당 10회 제한은 IP 당이라 IP 로테이션에 뚫립니다. 이 값이 하루 총량을 막습니다.
#   ⚠️ 기본·폴백 제공자의 콘솔 예산과 호출 한도보다 낮게 설정하세요.
# CHAT_DAILY_LIMIT=1000

# 방문 분석 동의 배너 표시 여부
NEXT_PUBLIC_FORCE_ANALYTICS_CONSENT_BANNER=1
