# ─────────────────────────────────────────────────────────────
# Aperture. 환경변수 예시
#   이 파일을 복사해서 `.env.local` 로 만들고 실제 값을 채우세요.
#     cp .env.example .env.local
#   `.env.local` 은 git 에 커밋되지 않습니다(.gitignore). 절대 커밋 금지.
#
#   ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출됩니다.
#      Firebase 웹 키(AIza…)는 공개돼도 안전합니다 — 보안은 Firestore/Storage
#      Security Rules 가 담당합니다(아키텍처 원칙 #1). 진짜 시크릿은 여기 없습니다.
# ─────────────────────────────────────────────────────────────

# ── 사이트 공개 URL (SEO 필수) ───────────────────────────────
# canonical, Open Graph, robots.txt, sitemap.xml의 절대 URL 기준입니다.
# 운영 환경에는 실제 대표 도메인을 프로토콜과 함께 입력하세요(끝의 /는 선택).
SITE_URL=https://example.com

# ── 검색엔진 소유 확인 (선택) ────────────────────────────────
# 각 웹마스터 도구에서 HTML meta 태그 방식을 선택한 뒤 content 값만 입력합니다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Firebase 웹 앱 설정 ──────────────────────────────────────
# 위치: Firebase 콘솔 → ⚙️ 프로젝트 설정(Project settings)
#        → 일반(General) 탭 → "내 앱(Your apps)" 섹션의 웹 앱 </> → firebaseConfig
#   (웹 앱이 아직 없으면 </> 아이콘으로 웹 앱을 먼저 등록. Hosting 체크는 불필요.)
#
# firebaseConfig 객체의 각 키 → 아래 변수로 옮기면 됩니다:
#   apiKey            → NEXT_PUBLIC_FIREBASE_API_KEY
#   authDomain        → NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   projectId         → NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   storageBucket     → NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#   messagingSenderId → NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   appId             → NEXT_PUBLIC_FIREBASE_APP_ID

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...............................
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── 관리자 UID (UI 가드용) ───────────────────────────────────
# 위치: Firebase 콘솔 → 빌드(Build) → Authentication → Users 탭 → 본인 계정의 "사용자 UID"
#   (먼저 Authentication 에서 이메일/비밀번호 로그인 활성화 + 관리자 계정 1개를
#    "사용자 추가"로 수동 생성해야 UID 가 생깁니다. 회원가입 UI 는 만들지 않습니다.)
#
#   ⚠️ UID 자체는 비밀이 아닙니다. Firestore/Storage는 Rules의 isAdmin()이,
#      캐시 재검증 server action은 Firebase가 검증한 ID token의 UID 비교가 권한을 판별합니다.
NEXT_PUBLIC_ADMIN_UID=your-admin-uid-from-authentication

# ── 콘텐츠 소스 스위치 (선택) ────────────────────────────────
# 공개 페이지가 mock 대신 실제 Firestore 를 읽을지 결정합니다. (lib/content/content-source.ts)
#   미설정(기본) : 개발(npm run dev)=mock, 프로덕션 빌드=실데이터
#   =0           : 항상 실데이터 — dev 에서도 Firestore 를 읽습니다(실콘텐츠 확인용)
#   =1           : 항상 mock  ⚠️ 프로덕션/Vercel 에는 설정 금지(실서비스가 mock 을 노출)
# 로컬에서 실데이터로 보려면 .env.local 에 이 줄을 넣으세요(앱이 실제로 읽는 파일은 .env.local 입니다).
NEXT_PUBLIC_USE_MOCK=0

# ── 연락 폼 발송 (Web3Forms) ─────────────────────────────────
# /contact 폼을 사이트 안에서 실제 발송하는 서비스. https://web3forms.com 에서
# 수신할 메일 주소를 입력하면 access key 를 무료로 발급해 줍니다(가입 불필요, 월 250건).
#   ⚠️ 이 키는 "수신 주소 매핑"용 공개 키라 브라우저 노출이 안전합니다(진짜 시크릿 아님).
#   미설정 시 폼은 mailto 폴백(방문자 메일 앱 열기)으로 동작합니다.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# 참고: 지도(MapLibre GL + CARTO)는 무료 타일이라 키가 필요 없습니다.

# ── 챗봇 제공자 (서버 전용) ───────────────────────────────────
# 로컬은 .env.local, 운영은 Vercel의 server-only 환경변수에 설정합니다.
#   ⚠️ API 키에 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 브라우저에 노출됩니다.
# CHAT_PROVIDER=mock 으로 설정하면 외부 API 없이 목 응답을 사용합니다.
CHAT_PROVIDER=gemini
CHAT_PROVIDER_MODEL=gemini-3.5-flash-lite
CHAT_PROVIDER_API_KEY=

# 임베딩 제공자 (서버 전용, 채팅 키와 분리)
EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER_API_KEY=

# 챗봇 공유 요청 제한 (운영 권장)
# Upstash Redis REST 설정이 모두 있으면 서버리스 인스턴스 간 공유 limiter를 사용합니다.
# Vercel Marketplace가 주입하는 KV_REST_API_URL + KV_REST_API_TOKEN도 자동 인식합니다.
# 미설정 또는 일시 장애 시에는 인스턴스 메모리 limiter로 폴백합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
