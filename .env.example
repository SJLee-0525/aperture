# ─────────────────────────────────────────────────────────────
# Aperture. 환경변수 예시
#   mock 공개 화면은 환경변수 없이 실행됩니다. 실제 Supabase나 선택 기능을 연결할 때만
#   이 파일을 복사해서 `.env.local` 로 만들고 필요한 값을 채우세요.
#     cp .env.example .env.local
#   `.env.local` 은 git 에 커밋되지 않습니다(.gitignore). 절대 커밋 금지.
#
#   ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출됩니다.
#      Supabase publishable key는 공개돼도 안전합니다. 보안은 Supabase RLS가 담당합니다.
#      진짜 시크릿은 여기 없습니다.
# ─────────────────────────────────────────────────────────────

# ── 사이트 공개 URL (SEO 필수) ───────────────────────────────
# canonical, Open Graph, robots.txt, sitemap.xml의 절대 URL 기준입니다.
# 운영 환경에는 실제 대표 도메인을 프로토콜과 함께 입력하세요(끝의 /는 선택).
SITE_URL=https://example.com

# ── 검색엔진 소유 확인 (선택) ────────────────────────────────
# 각 웹마스터 도구에서 HTML meta 태그 방식을 선택한 뒤 content 값만 입력합니다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ── Supabase (인증·데이터·Storage) ───────────────────────────
# 위치: Supabase 대시보드 → Project Settings → API Keys / Data API
#   publishable key(sb_publishable_...)는 공개돼도 안전합니다 — 권한은 RLS 가 판별합니다.
#   관리자 판별은 UID 비교가 아니라 관리자 계정의 app_metadata.role="admin" 클레임입니다 (ADR-0005).
#   (Authentication → Users 에서 관리자 계정 1개를 수동 생성하고 role 클레임을 넣습니다.
#    회원가입 UI 는 만들지 않습니다.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── 콘텐츠 소스 스위치 (선택) ────────────────────────────────
# 공개 페이지가 mock 대신 실제 Supabase 를 읽을지 결정합니다. (lib/content/content-source.ts)
#   미설정(기본) : 개발(npm run dev)=mock, 프로덕션 빌드=실데이터
#   =0           : 항상 실데이터 — dev 에서도 Supabase 를 읽습니다(실콘텐츠 확인용)
#   =1           : 항상 mock  ⚠️ 프로덕션 빌드에 설정하면 next.config.ts 가 즉시 실패시킵니다
#                  (Vercel 여부를 보지 않아 self-host 배포에도 걸립니다. E2E·시각 회귀만
#                   서버 전용 APERTURE_E2E_ALLOW_PRODUCTION_MOCK=1 로 열며, 로컬에서 mock
#                   프로덕션 빌드를 점검할 때도 그 플래그가 필요합니다.)
# 로컬에서 실데이터로 보려면 .env.local 에 이 줄을 넣으세요(앱이 실제로 읽는 파일은 .env.local 입니다).
#   ⚠️ B3.5부터 관리자 화면도 이 스위치를 따릅니다 — mock 이면 관리자 저장이 Supabase 가
#      아니라 브라우저 로컬 저장소로 갑니다(상단 MOCK 배지로 표시). 실데이터를 만질 때만 0.
NEXT_PUBLIC_USE_MOCK=1

# ── 관리자 테스트 세션 (개발·E2E 전용, 선택) ─────────────────
# =1 이면 AuthGuard 가 로그인 없이 열립니다. 관리자 계정 없이 mock 모드로
# 관리자 화면을 개발할 때 위의 NEXT_PUBLIC_USE_MOCK=1 과 함께 사용하세요.
#   ⚠️ 인증 우회 스위치입니다. 프로덕션 빌드에 =1 이 있으면 빌드가 즉시 실패합니다
#      (lib/auth/test-admin-session.ts) — Vercel 환경변수에 절대 넣지 마세요.
#   실제 보안 경계는 Supabase RLS 라 이 플래그로 실데이터 쓰기가 열리지는 않습니다.
# NEXT_PUBLIC_ADMIN_TEST_SESSION=1

# ── 연락 폼 발송 (Web3Forms) ─────────────────────────────────
# /contact 폼을 사이트 안에서 실제 발송하는 서비스. https://web3forms.com 에서
# 수신할 메일 주소를 입력하면 access key 를 무료로 발급해 줍니다(가입 불필요, 월 250건).
#   ⚠️ 이 키는 "수신 주소 매핑"용 공개 키라 브라우저 노출이 안전합니다(진짜 시크릿 아님).
#   미설정 시 폼은 mailto 폴백(방문자 메일 앱 열기)으로 동작합니다.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# ── Google Analytics 4 (선택) ────────────────────────────────
# 위치: GA 콘솔 → 관리(⚙️) → 데이터 스트림 → 웹 스트림 선택 → 우상단 "측정 ID"(G-XXXXXXXXXX)
#   비워 두면 gtag 스크립트를 아예 심지 않습니다(로컬 새로고침이 통계를 오염시키지 않도록
#   .env.local 에는 넣지 않는 것을 권장 — 실제 값은 Vercel 환경변수에만 두세요).
#   ⚠️ GA 콘솔 → 데이터 스트림 → 향상된 측정 → "브라우저 기록 이벤트 기반 페이지 변경"은 꺼야 합니다.
#      코드가 라우트 변경마다 page_view 를 직접 보내므로, 켜두면 조회수가 두 배로 잡힙니다.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Sentry 오류 모니터링 (선택) ──────────────────────────────
# 위치: Sentry → Settings → Projects → 프로젝트 선택 → Client Keys (DSN)
#   DSN이나 아래 저장 지역을 비우면 브라우저·Node·Edge에서 Sentry가 동작하지 않습니다.
#   DSN은 이벤트 수신 주소이므로 공개돼도 됩니다. AUTH_TOKEN은 공개하면 안 됩니다.
#   브라우저 수집은 동의 배너에서 오류 보고를 따로 허용한 뒤에만 시작됩니다(ADR-0004).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry 조직의 실제 데이터 저장 지역. DSN host가 ingest.us.sentry.io면 US,
# ingest.de.sentry.io면 DE. 미설정·불일치 시 개인정보 국외 이전 고지를 위해 Sentry가 비활성화됩니다.
NEXT_PUBLIC_SENTRY_DATA_REGION=US

# 소스맵 업로드 토큰 (빌드 전용 시크릿)
# 위치: Sentry → Settings → Auth Tokens (scopes: project:releases, org:read)
#   실제 값은 .env.sentry-build-plugin(로컬)과 Vercel 환경변수(Sensitive)에만 둡니다.
#   NEXT_PUBLIC_ 접두사를 붙이지 마세요. 값이 없으면 소스맵 업로드만 건너뛰며 빌드는 계속됩니다.
# SENTRY_AUTH_TOKEN=

# ── Sentry 알림 AI 트리아지 (선택) ───────────────────────────
# Sentry Alert → /api/sentry-alert → LLM 판정 → Discord 카드 (ADR-0006, docs/plan/10).
# 수신·기록·전송에 쓰는 인프라 시크릿 3종(아래 첫 세 줄)이 하나라도 비면 파이프라인이
# 서지 않습니다. 그때는 Sentry 기본 이메일 알림만 남습니다.
# 반대로 LLM 키가 없으면 판정만 빠지고 기본 카드는 그대로 나갑니다.
#   ⚠️ 전부 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#   ⚠️ Vercel 에는 Production 스코프 + Sensitive 로만 등록하세요. Preview 에 넣으면
#      공개 저장소의 프리뷰 배포가 같은 시크릿으로 실행됩니다.

# 웹훅 서명 검증용 Client Secret
# 위치: Sentry → Settings → Developer Settings → Custom Integrations → 통합 선택 → Client Secret
#   같은 화면의 Webhook URL 에 https://<도메인>/api/sentry-alert 을 등록합니다.
SENTRY_ALERT_WEBHOOK_SECRET=

# Supabase 기록 RPC 인가용 공유 시크릿 (직접 생성)
#   생성: openssl rand -hex 32
#   등록: Supabase SQL 에디터에서 같은 값의 해시를 1회 넣습니다.
#         insert into private.webhook_secrets
#           values ('sentry_alert', encode(digest('<생성한 값>','sha256'),'hex'));
#   DB 에는 해시만 남으므로 원문은 이 파일과 Vercel 에만 존재합니다.
SENTRY_ALERT_LOG_SECRET=

# 알림 카드를 받을 Discord 채널 웹훅 URL
# 위치: Discord → 채널 설정(⚙️) → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_ALERT_WEBHOOK_URL=

# 트리아지 제공자 — 챗봇과 같은 규약이라 아래 6줄을 통째로 맞바꾸면 모델이 바뀝니다.
#   TRIAGE_PROVIDER=mock 이면 외부 호출 없이 고정 결과로 흐름만 확인합니다.
#   키 값은 챗봇의 OpenAI 키와 같아도 동작합니다. 사용량을 따로 보려면 별도 발급하세요.
#   양쪽 제공자가 모두 실패하면 판정 없는 기본 카드가 나갑니다 — 알림이 끊기지는 않습니다.
TRIAGE_PROVIDER=openai
TRIAGE_PROVIDER_MODEL=gpt-5.6-luna
TRIAGE_PROVIDER_API_KEY=
TRIAGE_FALLBACK_PROVIDER=gemini
TRIAGE_FALLBACK_PROVIDER_MODEL=gemini-3.5-flash-lite
TRIAGE_FALLBACK_PROVIDER_API_KEY=

# 트리아지 LLM 호출의 하루 상한 (선택 — 기본 50, 리셋은 UTC 자정)
# 아래 챗봇과 같은 Upstash 자격증명을 재사용합니다. 상한을 넘으면 LLM 만 건너뛰고
# 기본 카드는 그대로 보냅니다. 비용을 막는 장치이지 알림을 막는 장치가 아닙니다.
# SENTRY_TRIAGE_DAILY_LIMIT=50

# ── WebMCP 오리진 트라이얼 (선택) ────────────────────────────
# 위치: https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241
#   프로덕션 도메인으로 발급한 토큰을 넣으면 지원 Chrome 에서 WebMCP 도구가 켜집니다.
#   비워 두면 meta 태그를 심지 않습니다 — 이 값 하나가 킬 스위치입니다(별도 플래그 없음).
#   로컬 검증은 토큰 없이 chrome://flags/#enable-webmcp-testing 활성화로 대체합니다.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=

# 참고: 지도(MapLibre GL + CARTO)는 무료 타일이라 키가 필요 없습니다.

# ── 챗봇 제공자 (서버 전용) ───────────────────────────────────
# 로컬은 .env.local, 운영은 Vercel의 server-only 환경변수에 설정합니다.
#   ⚠️ API 키에 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 브라우저에 노출됩니다.
# CHAT_PROVIDER=mock 으로 설정하면 외부 API 없이 목 응답을 사용합니다.
# 메인이 응답을 시작하기 전에 실패하면 별도 키를 쓰는 폴백 제공자로 넘어갑니다.
#
# 메인·서브는 아래 6줄을 통째로 맞바꾸기만 하면 되고 코드 수정은 필요 없습니다.
# (openai <-> gemini). 잘림 회수·출력 상한·오류 분류는 두 제공자가 공유하므로
# 어느 쪽을 메인에 두든 방문자가 보는 동작은 같습니다.
CHAT_PROVIDER=gemini
CHAT_PROVIDER_MODEL=gemini-3.5-flash-lite
CHAT_PROVIDER_API_KEY=
CHAT_FALLBACK_PROVIDER=openai
CHAT_FALLBACK_PROVIDER_MODEL=gpt-5.6-luna
CHAT_FALLBACK_PROVIDER_API_KEY=

# 최근 대화의 포트폴리오 섹션을 분류합니다(OpenAI 전용).
#   ⚠️ 채팅 제공자 키를 공유하지 않으므로 이 키를 직접 채워야 분류기가 켜집니다.
#      비워 두면 오류 없이 정규식 분류기로 동작합니다 — 조용히 품질만 떨어지니 주의하세요.
#      대신 챗봇을 Gemini로 바꿔도 분류기는 그대로 유지됩니다.
# 호출 실패·none 응답 시에도 정규식 분류기로 폴백합니다.
CHAT_INTENT_MODEL=gpt-5-nano
CHAT_INTENT_PROVIDER_API_KEY=
CHAT_INTENT_TIMEOUT_MS=3000

# 임베딩 제공자 (서버 전용, 채팅 키와 분리)
# 차원은 MRL 잘라내기(기본 512) — 코퍼스 규모 대비 품질 손실 없이 저장·전송 1/3.
#   ⚠️ 모델이나 차원을 바꾸면 저장·검색 호환성 키(모델명@차원)가 어긋나므로
#      /admin/maintenance 에서 전체 임베딩 재생성이 필요합니다.
EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER_DIMENSIONS=512
EMBEDDING_PROVIDER_API_KEY=

# 공유 요청 제한 (배포 환경 필수)
# 아래 한 쌍 대신 Vercel Marketplace 가 주입하는 KV_REST_API_URL + KV_REST_API_TOKEN 도
# 자동 인식합니다 — 그쪽을 쓰면 아래 두 줄은 비워 두세요.
#   ⚠️ 배포 환경에 자격증명이 없으면 챗을 503 으로 닫습니다. 인스턴스 메모리 폴백은
#      서버리스에서 동시 요청만으로 우회돼 제한이 있다는 착각만 남기기 때문입니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 전역 일일 상한 (선택 — 기본 1,000, 리셋은 UTC 자정)
# 분당 10회 제한은 IP 당이라 IP 로테이션에 뚫립니다. 이 값이 하루 총량을 막습니다.
#   ⚠️ 기본·폴백 제공자의 콘솔 예산과 호출 한도보다 낮게 설정하세요.
# CHAT_DAILY_LIMIT=1000

# 하루 입력 문자 예산 (선택 — 기본 2,000,000, 리셋은 UTC 자정)
# 요청 수만 세면 비용이 잡히지 않습니다. 글을 열어 둔 질문은 본문 최대 25,000자를 함께 보냅니다.
# 이 값을 넘으면 요청을 거절하는 대신 문맥(화면 본문·프로필·RAG)을 빼고 답합니다.
# CHAT_DAILY_INPUT_CHAR_LIMIT=2000000

# 방문 분석 동의 배너 표시 여부
NEXT_PUBLIC_FORCE_ANALYTICS_CONSENT_BANNER=1
