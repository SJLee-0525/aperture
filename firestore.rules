rules_version = '2';

// Aperture. — Firestore Security Rules
// 이 프로젝트에는 백엔드 서버가 없다. 이 Rules 가 보안 경계의 전부다 (CLAUDE.md 아키텍처 원칙 #1).
// 관리자 = 단일 UID 비교. 공개 쓰기는 없으며 모든 컬렉션 쓰기는 관리자만 허용한다.
// ⚠️ NEXT_PUBLIC_ADMIN_UID(.env.local) 와 아래 UID 는 수동 동기화 — 둘 다 같은 값이어야 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == "KBBvgyMIssPngwx9n0OXaL2THwy1";
    }

    match /photos/{id} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /albums/{id} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── 음악 섹션 — 무인증 쓰기 없음 ──
    match /musicWorks/{id} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /musicAwards/{id} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /musicMedia/{id} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── 개발 섹션 — 무인증 쓰기 없음 ──
    match /devProjects/{id} {
      allow read:  if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /site/{id} {
      allow read:  if true;      // name·bio·links·태그 사전은 공개
      allow write: if isAdmin();
    }

    // 명시하지 않은 컬렉션은 기본 거부 (match-all 허용 규칙 추가 금지).
  }
}
